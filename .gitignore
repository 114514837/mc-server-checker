# ==============================================
# mc-server-checker - .gitignore
# 列在这里的文件/文件夹不会被 git add 提交,
# 也就不会上传到 GitHub。
# ==============================================

# --- 敏感信息:环境变量与密钥(绝不提交!) ---
.env
.env.*
*.local
*.key
*.pem
*.crt
*.pfx
secrets.json

# --- 依赖目录 ---
# 本项目暂时不用 Node.js,先写上,防止以后用到
node_modules/

# --- 日志与临时文件 ---
*.log
tmp/
temp/

# --- 编辑器 / 操作系统文件 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
